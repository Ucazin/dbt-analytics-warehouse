# dbt build artifacts — regenerable from `dbt build`
target/
dbt_packages/
logs/
.user.yml

# Profiles (may contain credentials in prod) — commit profiles.yml.example instead
profiles.yml

# DuckDB warehouse — regenerated by scripts/seed_sources.py + dbt build
*.duckdb
*.duckdb.wal

# External raw drops (large) if you bring in real CSVs
seeds_external/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: outputs/ ARE committed (DAG render + lineage summary) so reviewers can
# see the warehouse shape without spinning anything up.
